    <span class="text-base mb-1 group-hover:scale-110 transition">📞</span>
    <span class="text-[10px] text-slate-500">전화상담</span>
    <span class="text-[9px] font-bold text-jmin-navy mt-0.5">하남/세종</span>
  </a>
  <a href="/location" class="py-3 px-1 hover:bg-slate-50 transition group flex flex-col items-center">
    <span class="text-base mb-1 group-hover:scale-110 transition">⏰</span>
    <span class="text-[10px] text-slate-500">진료시간</span>
    <span class="text-[9px] font-bold text-slate-700 mt-0.5">안내보기</span>
  </a>
  <a href="/location" class="py-3 px-1 hover:bg-slate-50 transition group flex flex-col items-center">
    <span class="text-base mb-1 group-hover:scale-110 transition">🗺️</span>
    <span class="text-[10px] text-slate-500">오시는 길</span>
    <span class="text-[9px] font-bold text-slate-700 mt-0.5">약도·주차</span>
  </a>
  <a href="https://blog.naver.com/yonseitree" target="_blank" rel="noopener" class="py-3 px-1 hover:bg-slate-50 transition group flex flex-col items-center bg-emerald-50/50">
    <span class="text-base mb-1 group-hover:scale-110 transition">📗</span>
    <span class="text-[10px] text-emerald-800">네이버</span>
    <span class="text-[9px] font-bold text-emerald-700 mt-0.5">블로그</span>
  </a>
  <button type="button" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" class="py-2.5 px-1 hover:bg-slate-100 transition text-[10px] text-slate-400 hover:text-slate-700 flex flex-col items-center">
