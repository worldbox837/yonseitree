  <div class="grid grid-cols-4 gap-2 text-center text-[11px] font-bold">
    <a href="tel:031-793-7575" class="py-2 rounded-xl bg-jmin-navy text-white flex flex-col items-center justify-center shadow-xs">
      <span class="text-base mb-0.5">📞</span>
      <span>하남 전화</span>
