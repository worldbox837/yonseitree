<%- include('partials/head', { title: '의료진 소개' }) %>
<%- include('partials/header') %>

<main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 space-y-16">
  
  <!-- J-Min Style Page Sub-Header -->
  <div class="text-center max-w-3xl mx-auto space-y-4">
    <span class="text-xs font-bold text-jmin-gold tracking-widest uppercase">Medical & Clinical Team</span>
    <h1 class="text-3xl sm:text-5xl font-serif font-extrabold text-slate-900 tracking-tight">연세나무 의료진 소개</h1>
    <p class="text-sm sm:text-base text-slate-500 font-light leading-relaxed">
      소아청소년정신의학 세부전문의 자격을 갖춘 원장단과 보건복지부 공인 1급 전문 치료사진이 온 가족의 마음 건강과 성장을 위해 정성을 다합니다.
    </p>
  </div>

  <!-- J-Min Filter Buttons -->
  <div class="flex flex-wrap items-center justify-center gap-2 pb-2">
    <button onclick="filterStaff('all', event)" data-filter="all" class="staff-filter-btn px-5 py-2.5 rounded-full text-xs font-bold bg-jmin-navy text-white shadow-xs transition">
      전체 의료진
    </button>
    <button onclick="filterStaff('doctor', event)" data-filter="doctor" class="staff-filter-btn px-5 py-2.5 rounded-full text-xs font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 transition">
      전문의 (원장단)
    </button>
    <button onclick="filterStaff('therapist', event)" data-filter="therapist" class="staff-filter-btn px-5 py-2.5 rounded-full text-xs font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 transition">
      전문 치료사진 (심리/언어)
    </button>
    <button onclick="filterStaff('hanam', event)" data-filter="hanam" class="staff-filter-btn px-5 py-2.5 rounded-full text-xs font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 transition">
      하남미사 클리닉
    </button>
    <button onclick="filterStaff('sejong', event)" data-filter="sejong" class="staff-filter-btn px-5 py-2.5 rounded-full text-xs font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 transition">
      세종 클리닉
    </button>
  </div>

  <!-- Staff Cards Grid (J-Min Style) -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <% doctors.forEach(doc => { %>
      <div id="<%= doc.id %>" class="staff-card bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-xs hover:shadow-md transition p-6 sm:p-10 flex flex-col justify-between"
           data-type="<%= doc.type %>" data-branch="<%= doc.branch %>">
        
        <div>
          <!-- Profile Top Info -->
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 mb-6">
            <% if (doc.image) { %>
              <img src="<%= doc.image %>" alt="<%= doc.name %>" class="w-28 h-28 sm:w-32 sm:h-32 rounded-2xl object-cover border border-slate-200 shadow-sm shrink-0 bg-slate-50" />
            <% } else { %>
              <div class="w-28 h-28 sm:w-32 sm:h-32 rounded-2xl bg-slate-100 text-slate-600 flex items-center justify-center font-bold text-4xl shrink-0">
                <%= doc.type === 'doctor' ? '👨‍⚕️' : '👩‍⚕️' %>
              </div>
            <% } %>

            <div class="space-y-1.5">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-xs font-bold px-2.5 py-0.5 rounded-full <%= doc.branch === 'hanam' ? 'bg-emerald-100 text-emerald-800' : 'bg-teal-100 text-teal-800' %>">
                  <%= doc.branch === 'hanam' ? '하남미사 클리닉' : (doc.branch === 'sejong' ? '세종 클리닉' : '공통') %>
                </span>
                <span class="text-xs font-medium px-2 py-0.5 rounded bg-slate-100 text-slate-600">
                  <%= doc.type === 'doctor' ? '정신건강의학과 전문의' : '전문 치료사' %>
                </span>
              </div>
              <h2 class="text-2xl font-serif font-bold text-slate-900">
                <%= doc.name %> <span class="text-sm font-normal text-slate-500 ml-1"><%= doc.role %></span>
              </h2>
              <p class="text-xs font-semibold text-jmin-navy leading-snug">
                <%= doc.title %>
              </p>
            </div>
          </div>

          <!-- Philosophy Quote -->
          <% if (doc.intro) { %>
            <div class="bg-slate-50 border-l-4 border-jmin-navy p-4 rounded-r-xl text-xs sm:text-sm text-slate-700 italic leading-relaxed mb-6 font-serif">
              "<%= doc.intro %>"
            </div>
          <% } %>

          <!-- Careers -->
          <div class="space-y-2">
            <h3 class="text-xs font-bold text-slate-900 flex items-center gap-1.5">
              <span>📋</span> 주요 약력 및 학술 활동
            </h3>
            <ul class="text-xs sm:text-sm text-slate-600 space-y-1.5 pl-1">
              <% (doc.career || []).forEach(c => { %>
                <li class="flex items-start gap-2">
                  <span class="text-slate-400 mt-0.5">&bull;</span>
                  <span class="leading-relaxed"><%= c %></span>
                </li>
              <% }) %>
            </ul>
          </div>
        </div>

        <div class="pt-4 mt-6 border-t border-slate-100 flex items-center text-xs text-slate-400">
          <span>연세나무 <%= doc.branch === 'hanam' ? '하남미사' : '세종' %> 클리닉</span>
        </div>

      </div>
    <% }) %>
  </div>

</main>

<script>
  function filterStaff(filter, evt) {
    const cards = document.querySelectorAll('.staff-card');
    const btns = document.querySelectorAll('.staff-filter-btn');

    btns.forEach(b => {
      b.className = 'staff-filter-btn px-5 py-2.5 rounded-full text-xs font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 transition';
    });
    
    const activeBtn = (evt && evt.currentTarget) ? evt.currentTarget : document.querySelector(`.staff-filter-btn[data-filter="${filter}"]`);
    if (activeBtn) {
      activeBtn.className = 'staff-filter-btn px-5 py-2.5 rounded-full text-xs font-bold bg-jmin-navy text-white shadow-xs transition';
    }

    cards.forEach(card => {
      const type = card.getAttribute('data-type');
      const branch = card.getAttribute('data-branch');

      if (filter === 'all') {
        card.classList.remove('hidden');
      } else if (filter === 'doctor' || filter === 'therapist') {
        if (type === filter) card.classList.remove('hidden');
        else card.classList.add('hidden');
      } else if (filter === 'hanam' || filter === 'sejong') {
        if (branch === filter || branch === 'all') card.classList.remove('hidden');
        else card.classList.add('hidden');
      }
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    const params = new URLSearchParams(window.location.search);
    const filter = params.get('filter') || params.get('tab') || params.get('type') || params.get('branch');
    if (filter) {
      filterStaff(filter);
    }
  });
</script>

<%- include('partials/footer') %>
