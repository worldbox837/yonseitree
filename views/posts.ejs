<%- include('partials/head', { title: '소통공간 ∙ 공지사항' }) %>
<%- include('partials/header') %>

<main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 space-y-12">
  
  <!-- Page Header (J-Min Style) -->
  <div class="text-center max-w-3xl mx-auto space-y-4">
    <span class="text-xs font-bold text-jmin-gold tracking-widest uppercase">Communication & Notice</span>
    <h1 class="text-3xl sm:text-5xl font-serif font-extrabold text-slate-900 tracking-tight">소통공간 ∙ 공지사항</h1>
    <p class="text-sm sm:text-base text-slate-500 font-light leading-relaxed">
      연세나무정신건강의학과의 주요 진료 일정, 방송 보도 및 마음건강 칼럼을 전해드립니다.
    </p>
  </div>

  <!-- J-Min Filter Buttons -->
  <div class="flex flex-wrap items-center justify-center gap-2">
    <button onclick="filterPosts('all')" class="post-filter-btn px-5 py-2.5 rounded-full text-xs font-bold bg-jmin-navy text-white shadow-xs transition">
      전체 글
    </button>
    <button onclick="filterPosts('공지사항')" class="post-filter-btn px-5 py-2.5 rounded-full text-xs font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 transition">
      공지사항
    </button>
    <button onclick="filterPosts('언론보도')" class="post-filter-btn px-5 py-2.5 rounded-full text-xs font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 transition">
      방송 및 언론보도
    </button>
    <button onclick="filterPosts('마음건강 칼럼')" class="post-filter-btn px-5 py-2.5 rounded-full text-xs font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 transition">
      마음건강 칼럼
    </button>
  </div>

  <!-- Post List Grid (J-Min Style Cards) -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% posts.forEach(post => { %>
      <a href="/posts/<%= post.id %>" class="post-card bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-xs hover:border-jmin-navy hover:shadow-md transition flex flex-col justify-between group"
         data-category="<%= post.category %>">
        
        <div>
          <% if (post.image) { %>
            <div class="h-48 overflow-hidden bg-slate-100">
              <img src="<%= post.image %>" alt="<%= post.title %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
            </div>
          <% } %>

          <div class="p-6 sm:p-7">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold px-2.5 py-0.5 rounded <%= post.category === '공지사항' ? 'bg-amber-100 text-amber-800' : (post.category === '언론보도' ? 'bg-rose-100 text-rose-800' : 'bg-slate-100 text-slate-700') %>">
                <%= post.category %>
              </span>
              <span class="text-xs text-slate-400 font-mono"><%= post.date %></span>
            </div>

            <h2 class="text-lg font-bold font-serif text-slate-900 group-hover:text-jmin-navy transition leading-snug mb-3 line-clamp-2">
              <%= post.pinned ? '📌 ' : '' %><%= post.title %>
            </h2>

            <p class="text-xs sm:text-sm text-slate-500 line-clamp-3 leading-relaxed font-light">
              <%= post.content %>
            </p>
          </div>
        </div>

        <div class="p-4 px-6 sm:px-7 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
          <span>조회 <%= post.views || 0 %></span>
          <span class="font-bold text-jmin-navy group-hover:underline">상세보기 &rarr;</span>
        </div>

      </a>
    <% }) %>
  </div>

</main>

<script>
  function filterPosts(cat) {
    const cards = document.querySelectorAll('.post-card');
    const btns = document.querySelectorAll('.post-filter-btn');

    btns.forEach(b => {
      b.className = 'post-filter-btn px-5 py-2.5 rounded-full text-xs font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 transition';
    });
    event.target.className = 'post-filter-btn px-5 py-2.5 rounded-full text-xs font-bold bg-jmin-navy text-white shadow-xs transition';

    cards.forEach(c => {
      const cardCat = c.getAttribute('data-category');
      if (cat === 'all' || cardCat === cat) {
        c.classList.remove('hidden');
      } else {
        c.classList.add('hidden');
      }
    });
  }
</script>

<%- include('partials/footer') %>
