<%- include('../partials/head', { title: '관리자 로그인' }) %>

<main class="min-h-screen flex items-center justify-center p-4 bg-slate-900">
  <div class="max-w-md w-full bg-white rounded-3xl p-8 sm:p-10 shadow-2xl space-y-6">
    
    <div class="text-center space-y-2">
      <div class="w-14 h-14 rounded-2xl bg-brand-600 text-white flex items-center justify-center font-bold text-3xl mx-auto shadow-md">
        🌲
      </div>
      <h1 class="text-2xl font-extrabold text-slate-900">연세나무 관리자 모드</h1>
      <p class="text-xs text-slate-500">홈페이지 첫 페이지 배치, 의료진, 게시글을 관리합니다.</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="p-3.5 bg-rose-50 border border-rose-200 text-rose-800 rounded-xl text-xs font-semibold">
        <%= error %>
      </div>
    <% } %>

    <form action="/admin/login" method="POST" class="space-y-4">
      <div>
        <label for="password" class="block text-xs font-bold text-slate-700 mb-1.5">관리자 비밀번호</label>
        <input type="password" id="password" name="password" required placeholder="비밀번호를 입력하세요"
               class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm" />
        <p class="text-[11px] text-slate-400 mt-1">초기 비밀번호: <code class="bg-slate-100 px-1 py-0.5 rounded text-slate-700 font-mono">admin1234</code></p>
      </div>

      <button type="submit" class="w-full py-3 bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm rounded-xl transition shadow-sm">
        로그인
      </button>
    </form>

    <div class="text-center pt-2">
      <a href="/" class="text-xs text-slate-400 hover:text-slate-600">
        &larr; 홈페이지로 돌아가기
      </a>
    </div>

  </div>
</main>

</body>
</html>
