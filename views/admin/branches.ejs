<%- include('../partials/head', { title: '지점 & 진료현황 관리' }) %>
<%- include('../partials/admin-nav', { activeMenu: 'branches' }) %>

<main class="flex-1 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10">
  
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-6">
    <div>
      <span class="text-xs font-bold text-emerald-600 uppercase tracking-wider">Branch & Schedule Management</span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">지점 & 진료현황 관리</h1>
      <p class="text-xs sm:text-sm text-slate-500 mt-1">
        하남미사 클리닉과 세종 클리닉의 실시간 접수 안내 뱃지, 진료시간표, 주소 및 연락처를 변경합니다.
      </p>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-2xl text-xs sm:text-sm font-semibold flex items-center gap-2">
      <span>✅</span> <%= success %>
    </div>
  <% } %>

  <form action="/admin/branches" method="POST" class="space-y-8">

    <% (settings.branches || []).forEach((b, idx) => { %>
      <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-xs space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
          <div class="flex items-center gap-3">
            <span class="text-2xl">🏥</span>
            <div>
              <h2 class="text-lg font-bold text-slate-900"><%= b.name %> 설정</h2>
              <input type="hidden" name="branchId[]" value="<%= b.id %>" />
            </div>
          </div>
        </div>

        <!-- 실시간 접수 상태 & 뱃지 색상 -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">상태 뱃지 텍스트</label>
            <input type="text" name="statusBadge_<%= b.id %>" value="<%= b.statusBadge %>" required
                   class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs font-bold focus:ring-2 focus:ring-emerald-500 focus:outline-none" />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">뱃지 색상</label>
            <select name="statusClass_<%= b.id %>" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-emerald-500 focus:outline-none bg-white">
              <option value="amber" <%= b.statusClass === 'amber' ? 'selected' : '' %>>주황/주의 (초진 마감 등)</option>
              <option value="emerald" <%= b.statusClass === 'emerald' ? 'selected' : '' %>>초록/정상 (정상 진료 중)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">대표 전화번호</label>
            <input type="text" name="tel_<%= b.id %>" value="<%= b.tel %>" required
                   class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-emerald-500 focus:outline-none" />
          </div>
        </div>

        <!-- 상태 상세 안내문 -->
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">실시간 접수/예약 상태 상세 설명</label>
          <textarea name="statusMessage_<%= b.id %>" rows="2" required
                    class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs leading-relaxed focus:ring-2 focus:ring-emerald-500 focus:outline-none"><%= b.statusMessage %></textarea>
        </div>

        <!-- 주소 & 주차 -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">상세 주소</label>
            <input type="text" name="address_<%= b.id %>" value="<%= b.address %>" required
                   class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-emerald-500 focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">주차 안내</label>
            <input type="text" name="parking_<%= b.id %>" value="<%= b.parking %>" required
                   class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-emerald-500 focus:outline-none" />
          </div>
        </div>

        <!-- 진료시간 -->
        <div class="space-y-3 pt-2 border-t border-slate-100">
          <label class="block text-xs font-bold text-slate-800">진료시간 문구 설정</label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <span class="text-[11px] text-slate-500 block mb-1">평일 진료시간</span>
              <input type="text" name="weekday_<%= b.id %>" value="<%= (b.hours && b.hours.weekday) || '' %>"
                     class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs" />
            </div>
            <div>
              <span class="text-[11px] text-slate-500 block mb-1">토요일 진료시간</span>
              <input type="text" name="saturday_<%= b.id %>" value="<%= (b.hours && b.hours.saturday) || '' %>"
                     class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs" />
            </div>
            <div>
              <span class="text-[11px] text-slate-500 block mb-1">점심시간</span>
              <input type="text" name="lunch_<%= b.id %>" value="<%= (b.hours && b.hours.lunch) || '' %>"
                     class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs" />
            </div>
            <div>
              <span class="text-[11px] text-slate-500 block mb-1">휴진일</span>
              <input type="text" name="holiday_<%= b.id %>" value="<%= (b.hours && b.hours.holiday) || '' %>"
                     class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs" />
            </div>
          </div>
        </div>

      </div>
    <% }) %>

    <!-- Submit Bar -->
    <div class="sticky bottom-4 z-30 bg-white/95 backdrop-blur-md p-4 rounded-2xl border border-slate-300 shadow-xl flex items-center justify-between">
      <span class="text-xs text-slate-500">저장 시 지점 정보와 접수 뱃지가 즉시 갱신됩니다.</span>
      <button type="submit" class="px-8 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm rounded-xl transition shadow-md">
        지점 설정 저장하기
      </button>
    </div>

  </form>

</main>

<%- include('../partials/footer') %>
