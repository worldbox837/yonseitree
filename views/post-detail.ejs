<%- include('partials/head', { title: post.title }) %>
<%- include('partials/header') %>

<main class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
  
  <div class="bg-white rounded-3xl border border-warm-200 p-6 sm:p-12 shadow-xs space-y-8">
    
    <!-- Post Header -->
    <div class="border-b border-slate-100 pb-6 space-y-4">
      <div class="flex items-center gap-3">
        <span class="text-xs font-bold px-3 py-1 rounded-full <%= post.category === '공지사항' ? 'bg-amber-100 text-amber-800' : (post.category === '언론보도' ? 'bg-rose-100 text-rose-800' : 'bg-brand-100 text-brand-800') %>">
          <%= post.category %>
        </span>
        <span class="text-xs text-slate-400">작성일: <%= post.date %></span>
        <span class="text-xs text-slate-400">&bull; 조회수: <%= post.views || 0 %></span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-snug">
        <%= post.title %>
      </h1>
    </div>

    <!-- Attached Media (YouTube Video or Image) -->
    <% if (post.youtubeId) { %>
      <div class="space-y-3">
        <div class="relative w-full aspect-video rounded-2xl overflow-hidden shadow-md border border-slate-200 bg-slate-950">
          <iframe class="absolute inset-0 w-full h-full" src="https://www.youtube.com/embed/<%= post.youtubeId %>" title="<%= post.title %>" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
        <% if (post.link) { %>
          <div class="flex justify-end">
            <a href="<%= post.link %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold text-xs shadow-xs transition">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              <span>유튜브 공식 영상 바로보기 &rarr;</span>
            </a>
          </div>
        <% } %>
      </div>
    <% } else if (post.image) { %>
      <div class="rounded-2xl overflow-hidden border border-slate-200">
        <img src="<%= post.image %>" alt="<%= post.title %>" class="w-full max-h-[500px] object-cover" />
      </div>
    <% } %>

    <!-- Content Body -->
    <div class="prose max-w-none text-slate-700 text-sm sm:text-base leading-relaxed whitespace-pre-line py-4">
      <%= post.content %>
    </div>

    <!-- Bottom Actions -->
    <div class="border-t border-slate-100 pt-6 flex items-center justify-between">
      <a href="/posts" class="px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition">
        &larr; 목록으로 돌아가기
      </a>
      <a href="https://blog.naver.com/yonseitree" target="_blank" rel="noopener" class="text-xs font-bold text-brand-700 hover:underline">
        공식 블로그에서 더 보기 &rarr;
      </a>
    </div>

  </div>

</main>

<%- include('partials/footer') %>
